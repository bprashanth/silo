  "transcript": [
    {
      "role": "assistant",
      "text": "Hello, you've reached the livestock assistance service. Please tell me what's happening.",
      "final": true
    },
    {
      "role": "user",
      "text": "My cow is sick.",
      "final": true
    },
    {
      "role": "assistant",
      "text": "I'm sorry to hear that. Could you tell me your name, please?",
      "final": true,
      "transcript_basis": "provider_audio_transcript"
    },
    {
      "role": "user",
      "text": "My name is Ramesh. I live in Demo Village in Demo District. One cow is affected. She has not been eating and is very weak since yesterday.",
      "final": true
    },
    {
      "role": "assistant",
      "text": "Thank you, Ramesh. Is your cow having trouble standing or breathing? That would be important to know.",
      "final": true,
      "transcript_basis": "provider_audio_transcript"
    },
    {
      "role": "user",
      "text": "She cannot stand up, and she is breathing very fast.",
      "final": true
    },
    {
      "role": "assistant",
      "text": "This sounds like an urgent situation. This needs urgent veterinary attention. Could you share your contact details, please?",
      "final": true,
      "transcript_basis": "provider_audio_transcript"
    },
    {
      "role": "user",
      "text": "There has been no previous treatment. I do not have a contact number to share.",
      "final": true
    },
    {
      "role": "assistant",
      "text": "Thank you, Ramesh. Let’s summarize: One cow, not eating, very weak since yesterday, cannot stand, fast breathing, no previous treatment, no contact number. Is that correct?",
      "final": true,
      "transcript_basis": "provider_audio_transcript"
    },
    {
      "role": "user",
      "text": "Yes, that summary is correct, thank you.",
      "final": true
    },
    {
      "role": "assistant",
      "text": "Understood. This situation needs urgent veterinary attention. I’ll flag this for review. This demo request is recorded. No real service is dispatched. Please seek professional help immediately.",
