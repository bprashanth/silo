    },
    {
      "role": "user",
      "text": "There has been no previous treatment. I do not have a contact number to share.",
      "final": true
    },
    {
      "role": "assistant",
      "text": "Thank you for letting me know. To confirm, your cow is unable to stand and breathing fast since yesterday, with no previous treatment. Is that correct?",
      "final": true,
      "transcript_basis": "provider_audio_transcript"
    },
    {
      "role": "user",
      "text": "Yes, that summary is correct, thank you.",
